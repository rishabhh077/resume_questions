{
  "name": "interviewprep-ai",
  "private": true,
  "version": "1.0.0",
  "description": "Turn your resume into personalized interview questions, answers and AI mock interviews.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c magenta,blue \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "vite",
    "dev:server": "node --watch server/index.js",
    "build": "vite build",
    "start": "NODE_ENV=production node server/index.js",
    "preview": "npm run build && npm start"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "dotenv": "^16.4.5",
    "express": "^4.22.3",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.77.0",
    "mammoth": "^1.13.0",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.19",
    "vite": "^5.4.21"
  }
}
